# ⚙️ CONFIGURACIÓN DE ACE CORPORATION CHATBOT
# Copia este archivo a .env y reemplaza los valores

# 🔐 Clave API de Anthropic (Claude)
# Obtén tu clave gratuita en: https://console.anthropic.com/
# Formato: sk-ant-v6-...
ANTHROPIC_API_KEY=sk-ant-v6-TU-CLAVE-AQUI

# 🌐 Puerto del servidor (por defecto 3000)
PORT=3000

# 📧 Email para recibir formularios (opcional - ya configurado en HTML)
CONTACT_EMAIL=ace@ace.com.uy

# 🔗 URL de tu sitio (cuando esté en producción)
# SITE_URL=https://tu-dominio.com
