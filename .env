# ⚙️ ACE Corporation — Variables de entorno
# YA NO SE NECESITA NINGUNA API KEY (el chatbot funciona sin IA).

# 🔐 Contraseña del panel admin (/admin)
# Cambiala por algo fuerte. Es la contraseña del usuario "admin".
ADMIN_PASSWORD=ace-admin-2025

# 🌍 (Opcional) IPs autorizadas para entrar al panel admin.
# Vacío = cualquier IP puede intentar loguearse. Ejemplo: 203.0.113.45,190.64.1.10
ADMIN_IPS=

# 🌐 Puerto (en DigitalOcean se asigna solo, dejalo así)
PORT=3000

# 🗄️ (Opcional en local) Base de datos PostgreSQL para que los logs/IPs persistan.
# En DigitalOcean App Platform: al adjuntar una base de datos, DATABASE_URL
# se crea SOLA, no hace falta ponerla acá.
# En local, si no la ponés, el sistema guarda en archivos .json automáticamente.
# DATABASE_URL=postgresql://usuario:clave@host:5432/basededatos?sslmode=require
